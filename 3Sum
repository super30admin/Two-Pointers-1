class Solution {
    /**
    1. Brute Force: Nested iterations solution.
    2. Hashing Solution: Fix one number and 2 sum on remaining elements.
    3. Sort Array and do binary search: Fix 2 numbers  and do binary search for searching that complement in the remaining array.
    4. Sort the Array and use 2 pointers technique. Fix one number and take left and right pointer to find the remining sum/target.
     */

    /**
    Time: O(N^3) Space:O(N2)
     */
    public List<List<Integer>> threeSumWithNestedIterations(int[] nums) {
        HashSet<List<Integer>> set = new HashSet<>();

        for (int i = 0; i < nums.length - 2; i++) {
            for (int j = i + 1; j < nums.length - 1; j++) {
                for (int k = j + 1; k < nums.length; k++) {
                    if (nums[i] + nums[j] + nums[k] == 0) {
                        List<Integer> triplet = Arrays.asList(nums[i], nums[j], nums[k]);
                        Collections.sort(triplet);
                        set.add(triplet);
                    }

                }

            }
        }
        return new ArrayList<>(set);

    }



    /**
    First sort the array so we can avoid duplicates and use binary search.
    Then fix 2 numbers and check if the third number present in the array using binary search.
    Store the valid triplet in the result
    
    Time: O(N^2 logN)
    Space:0(1)
     */
    public List<List<Integer>> threeSumWithBinarySearch(int[] nums) {
        Arrays.sort(nums);
        int n = nums.length;
        int target = 0;
        List<List<Integer>> result = new ArrayList<>();
        for (int i = 0; i < n - 2; i++) {

            if (i > 0 && nums[i] == nums[i - 1])
                continue;

            int innerTarget = target - nums[i];

            //Find 2 numbers whose sum is innerTarget
            //Traverse over remaining numbers and 
            for (int j = i + 1; j < n; j++) {

                if (j != i + 1 && nums[j] == nums[j - 1])
                    continue;

                int complement = innerTarget - nums[j];
                int idx = binarySearch(nums, j + 1, nums.length - 1, complement);
                if (idx != -1) {
                    List<Integer> triplet = Arrays.asList(nums[i], nums[j], nums[idx]);
                    result.add(triplet);
                }
            }
        }

        return result;
    }

    private int binarySearch(int[] nums, int left, int right, int target) {

        while (left <= right) {
            int mid = left + (right - left) / 2;
            if (nums[mid] == target)
                return mid;
            else if (target < nums[mid])
                right = mid - 1;
            else
                left = mid + 1;
        }

        return -1;
    }

        /**
    Time:O(N^2)
    Space: O(N)
     */

    public List<List<Integer>> threeSumWithHashing(int[] nums) {
        HashSet<List<Integer>> resultSet = new HashSet<>();
        int target = 0;
        //Fix first number
        for (int i = 0; i < nums.length - 2; i++) {
            if (i > 0 && nums[i] == nums[i - 1])
                continue;
            Set<Integer> set = new HashSet<>();
            int remainingTarget = target - nums[i];

            //find 2 numbers whose sum is remainingTarget.
            for (int j = i + 1; j < nums.length; j++) {
                int complement = remainingTarget - nums[j];
                if (set.contains(complement)) {
                    List<Integer> triplet = Arrays.asList(nums[i], nums[j], complement);
                    Collections.sort(triplet);
                    resultSet.add(triplet);
                }
                set.add(nums[j]);
            }

        }
        return new ArrayList<>(resultSet);
    }

    /* Approach: Sort the array so we can use two pointers efficiently.
    For each number, fix it and look for two other numbers using left and right pointers.
    Skip duplicates to avoid repeating the same triplet in the result.
    
    Time: O(N ^2)
    Space:O(1)
    */
    public List<List<Integer>> threeSumWithTwoPointers(int[] nums) {
        Arrays.sort(nums); //nlogn
        List<List<Integer>> result = new ArrayList<>();
        //Pick first number
        for (int i = 0; i < nums.length - 2; i++) {
            int left = i + 1;
            int right = nums.length - 1;

            //handle outer duplicacy
            if (i > 0 && nums[i] == nums[i - 1])
                continue;
            // improvement
            if (nums[i] > 0)
                break; // if the first number itself is greater than 0 then we are not going to get sum of numbers euals to 0 as numbers are sorted.

            while (left < right) {
                int sum = nums[i] + nums[left] + nums[right];
                if (sum == 0) {
                    //Found triplet
                    result.add(List.of(nums[i], nums[left], nums[right]));
                    left++;
                    right--;
                    //handle inner duplicacy
                    while (left < right && nums[left] == nums[left - 1]) {
                        left++;

                    }
                    while (left < right && nums[right] == nums[right + 1]) {
                        right--;

                    }

                } else if (sum < 0) {
                    left++;

                } else {
                    right--;

                }

            }

        }
        return result;
    }

    public List<List<Integer>> threeSum(int[] nums) {
        //return threeSumWithNestedIterations(nums);
        return threeSumWithHashing(nums);
        //return threeSumWithTwoPointers(nums);
        //return threeSumWithBinarySearch(nums);
    }
}