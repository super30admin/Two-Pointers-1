// Use low, mid and high pointers for colors 0, 1 and 2 respectively
// Swap mid and high if the mid element is 2, swap low and mid if mid element is 0
// Skip to next element if mid element is 1. Continue till mid crosses high pointer

// Your code here along with comments explaining your approach
class Solution {
    public void sortColors(int[] nums) {
        int low = 0, mid = 0;
        int high = nums.length - 1;
        while(mid <= high) {
            // swap low and mid
            if(nums[mid] == 0) {
                swap(nums, mid, low);
                low++;
                mid++;
            }
            // swap high and mid
            else if(nums[mid] == 2) {
                swap(nums, mid, high);
                high--;
            }
            else {
                mid++;
            }
        }
    }
    // Function to swap elements in the array
    public void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}