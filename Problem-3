// Keep a low and high pointer
// Calculate the max amount of water between the 2 heights between low and high
// move the pointer which is lesser in height till the pointers cross eachother 

// Your code here along with comments explaining your approach

class Solution {
    public int maxArea(int[] height) {
        int low = 0;
        int high = height.length-1;
        int max = Integer.MIN_VALUE;
        while(low <= high) {
            // calculate max amount of water
            max = Math.max(max, Math.min(height[low], height[high])*(high-low));
            if(height[low] < height[high])
                low++;
            else
                high--;
        }
        return max;
    }
}