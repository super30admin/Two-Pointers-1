class Solution {
    public void sortColors(int[] nums) {
        int left = 0; //Collect all 0s
        int mid = 0; //collect all 1's 
        int right = nums.length - 1; //collect all 2s

        while (mid <= right) {
            if (nums[mid] == 2) {
                swap(nums, mid, right);
                right--;
            } else if (nums[mid] == 0) {
                swap(nums, mid, left);
                left++;
                mid++;
            } else {
                mid++;
            }

        }

    }

    void swap(int[] nums, int i, int j) {
        int temp = nums[i];
        nums[i] = nums[j];
        nums[j] = temp;
    }
}